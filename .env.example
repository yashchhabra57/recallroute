# Copy to .env (never commit .env). Every setting is optional.

# Listen address.
RECALLROUTE_ADDR=:8080

# PostgreSQL connection string. Leave empty to use the in-memory store
# (fine for a demo; data is lost on restart).
DATABASE_URL=postgres://recallroute:recallroute@localhost:5432/recallroute?sslmode=disable

# Bearer token required on every write (imports, ingests, workflow
# actions). Leave empty only on a trusted network.
RECALLROUTE_API_TOKEN=change-me

# Recall feed to poll. openFDA food enforcement reports for a date window:
# RECALLROUTE_FEED_URL=https://api.fda.gov/food/enforcement.json?search=report_date:[20261101+TO+20261231]&limit=100
RECALLROUTE_FEED_URL=
RECALLROUTE_POLL_INTERVAL=6h
